{
  "name": "klir-ia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate-skills": "node scripts/generate-skills.mjs",
    "bundle-skills": "node scripts/bundle-skills.mjs",
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "put-secrets": "node scripts/put-secrets.mjs",
    "prebuild": "node scripts/generate-skills.mjs && node scripts/bundle-skills.mjs",
    "eval": "node scripts/run-evals.mjs",
    "eval:dry": "node scripts/run-evals.mjs --dry-run",
    "eval:trading": "node scripts/eval-trading-charts.mjs",
    "db:migrate:local": "wrangler d1 migrations apply klir-ia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply klir-ia-db --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "lucide-react": "^0.542.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.0"
  }
}
