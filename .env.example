# Klir IA — variables d'environnement

# --- Auth Klir IA (email + mot de passe, D1) ---
# Clerk n'est plus requis — connexion native sur /sign-in et /sign-up

# --- Auth Clerk (legacy, optionnel) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Providers (au moins 1 requis en prod) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- Modèles (optionnel) ---
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-small-latest

# Ordre de fallback (comma-separated)
AI_PROVIDER_ORDER=openai,anthropic,gemini,openrouter,groq,mistral

# Voix plus naturelle (0.6–0.85 recommandé)
AI_TEMPERATURE=0.72
AI_MAX_TOKENS=1800
AI_SITE_MAX_TOKENS=8192

AI_SANDBOX=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limit
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=3600000

# --- Billing ---
# Stripe (one-time — forfaits 24h / 7j / 30j)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PASS24H=
STRIPE_PRICE_PASS7D=
STRIPE_PRICE_PASS30D=

# MonCash Digicel (Haïti — mois prépayé HTG)
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_BUSINESS_KEY=
MONCASH_SANDBOX=false

# USDT — NOWPayments (recommandé) ou portefeuille manuel
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
USDT_PAY_CURRENCY=usdttrc20
USDT_WALLET_ADDRESS=
USDT_NETWORK=TRC20
TRONGRID_API_KEY=

# Sel pour hachage IP (rate limit invité / auth) — générez une chaîne aléatoire longue
SECURITY_SALT=

# Courriel (reset mot de passe)
RESEND_API_KEY=
EMAIL_FROM=Klir IA <noreply@klirline.io>

# Compte Binance USDT (retrait TRC20) — prioritaire sur USDT_WALLET_ADDRESS
BINANCE_USDT_ADDRESS=
# Taux conversion HTG → USDT (ex. 130 = 1 USDT vaut 130 gourdes)
USDT_HTG_RATE=130

# --- Marché / trading (Phase 5+) ---
# Alpha Vantage — forex + actions US (gratuit, 25 req/jour)
ALPHA_VANTAGE_API_KEY=
# Binance lecture seule (sync portefeuille — à venir, sans permission retrait)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# eToro OAuth / clé partenaire (lecture seule — à venir)
ETORO_ACCESS_TOKEN=
ETORO_API_KEY=
ETORO_USER_KEY=

# --- Studio médias licenciés (API officielles — pas de scraping) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# --- Crédits Klir IA ---
FREE_CREDITS=45
CREDITS_PER_ACTION=1
FREE_CREDITS_REFILL_HOURS=5
# Emails admin (virgules) — accès /dashboard/admin/credits
KLIR_ADMIN_EMAILS=contact@klirline.ca
# Secret optionnel pour API admin (header x-klir-admin-secret)
KLIR_ADMIN_SECRET=

# --- Évals golden set (CI / npm run eval) ---
# Si défini, les requêtes avec header X-Eval-Key bypassent la limite invité (3 recherches).
EVAL_API_KEY=
